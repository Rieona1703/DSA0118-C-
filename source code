// TASK 1 & 2: OBJECTS AND CONSTANTS
enum class Zone { Inner=0, Middle=1, Outer=2, Airport=3 };
const long long BASE_FARE[4]={1000,2000,3000,6000};
const int PEAK_SURCHARGE=20;
const int WEEKEND_DISCOUNT=10;
const long long MIN_BALANCE=5000;

struct Passenger {
    string name, category;
};
struct Journey {
    Zone zone;
    int hour;
    bool weekend;
};

// TASK 7: SMART CARD CLASS
class SmartCard {
private:
    long long balance;
public:
    SmartCard(long long amount) {
        balance=(amount>=0)?amount:0;
    }
    bool canTravel(long long fare) const {
        return fare>=0 && balance>=fare && balance-fare>=MIN_BALANCE;
    }
    bool deduct(long long fare) {
        if(!canTravel(fare)) return false;
        balance-=fare;
        return true;
    }
    bool recharge(long long amount) {
        if(amount<=0 || balance>LLONG_MAX-amount) return false;
        balance+=amount;
        return true;
    }
    long long getBalance() const {
        return balance;
    }
};

// TASK 12: MONTHLY PASS CLASS
class MonthlyPass {
private:
    Zone firstZone, secondZone;
public:
    MonthlyPass(Zone first, Zone second) {
        firstZone=first;
        secondZone=second;
    }
    bool covers(Zone zone) const {
        return zone==firstZone || zone==secondZone;
    }
};

// COMMON FARE FUNCTIONS
bool validZone(Zone zone) {
    int index=static_cast<int>(zone);
    return index>=0 && index<4;
}
bool isPeakHour(int hour) {
    return (hour>=8 && hour<10) || (hour>=17 && hour<20);
}

// TASK 5, 6, 9 AND 11: ORIGINAL FARE CALCULATION
long long calculateOriginalFare(Zone zone,int hour) {
    if(!validZone(zone) || hour<0 || hour>23) return -1;
    long long fare=0;
    switch(zone) {
        case Zone::Inner: fare=BASE_FARE[0]; break;
        case Zone::Middle: fare=BASE_FARE[1]; break;
        case Zone::Outer: fare=BASE_FARE[2]; break;
        case Zone::Airport: fare=BASE_FARE[3]; break;
        default: return -1;
    }
    if(isPeakHour(hour))
        fare+=fare*PEAK_SURCHARGE/100;
    return fare;
}

// TASK 12: REVISED FARE CALCULATION
long long calculateRevisedFare(Zone zone,int hour,bool weekend,const MonthlyPass &pass) {
    if(!validZone(zone) || hour<0 || hour>23) return -1;
    if(pass.covers(zone)) return 0;
    int index=static_cast<int>(zone);
    long long fare=BASE_FARE[index];
    if(weekend)
        fare=fare*(100-WEEKEND_DISCOUNT)/100;
    else if(isPeakHour(hour))
        fare+=fare*PEAK_SURCHARGE/100;
    return fare;
}

void printMoney(long long paise) {
    cout<<"Rs "<<paise/100<<"."<<setw(2)<<setfill('0')<<paise%100<<setfill(' ');
}

