// TASK 7 - REDESIGN AND VALIDATION

const int SIZE = 10;

class OriginalAccount
{
private:
    double transactions[SIZE];
    int count;

public:
    OriginalAccount()
    {
        count = 0;
    }

    void addTransaction(double amount)
    {
        if (count < SIZE)
        {
            transactions[count] = amount;
            count++;
        }
        else
        {
            for (int i = 0; i < SIZE - 1; i++)
                transactions[i] = transactions[i + 1];

            transactions[SIZE - 1] = amount;
        }
    }

    void display()
    {
        cout << "Original Transactions: ";

        for (int i = 0; i < count; i++)
            cout << transactions[i] << " ";

        cout << endl;
    }
};

class CircularAccount
{
private:
    double transactions[SIZE];
    int count;
    int next;

public:
    CircularAccount()
    {
        count = 0;
        next = 0;
    }

    void addTransaction(double amount)
    {
        transactions[next] = amount;
        next = (next + 1) % SIZE;

        if (count < SIZE)
            count++;
    }

    void display()
    {
        cout << "Circular Transactions: ";

        int start = (next - count + SIZE) % SIZE;

        for (int i = 0; i < count; i++)
        {
            int index = (start + i) % SIZE;
            cout << transactions[index] << " ";
        }

        cout << endl;
    }
};

