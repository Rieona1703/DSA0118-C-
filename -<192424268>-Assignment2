// TASK 1 - CALL BY VALUE, REFERENCE AND POINTER

void applyByValue(long long fee, int percent)
{
    fee -= fee * percent / 100;
}

void applyByReference(long long& fee, int percent)
{
    fee -= fee * percent / 100;
}

void applyByPointer(long long* fee, int percent)
{
    *fee -= (*fee) * percent / 100;
}

void change(int a, int& b, int* c)
{
    a += 10;
    b += 10;
    *c += 10;
}

int& bigger(int& p, int& q)
{
    return p > q ? p : q;
}

void show(int x, int y = 5, int z = 10)
{
    cout << x + y + z << " ";
}

void task1()
{
    cout << "\n========== TASK 1 ==========\n";

    long long fee1 = 45000;
    long long fee2 = 45000;
    long long fee3 = 45000;

    applyByValue(fee1, 10);
    applyByReference(fee2, 10);
    applyByPointer(&fee3, 10);

    cout << "Call by Value: " << fee1 << endl;
    cout << "Call by Reference: " << fee2 << endl;
    cout << "Call by Pointer: " << fee3 << endl;

    int a = 1, b = 2, c = 3;

    change(a, b, &c);
    cout << "After change: " << a << " " << b << " " << c << endl;

    bigger(a, c) = 100;
    cout << "After bigger: " << a << " " << c << endl;

    cout << "Default arguments: ";
    show(1);
    show(1, 2);
    show(1, 2, 3);
    cout << endl;
}

// TASK 2 - RETURN BY REFERENCE

int highestIndex(int marks[], int size)
{
    int index = 0;

    for (int i = 1; i < size; i++)
    {
        if (marks[i] > marks[index])
            index = i;
    }

    return index;
}

int& highestMark(int marks[], int size)
{
    return marks[highestIndex(marks, size)];
}

const int& highestMarkConst(int marks[], int size)
{
    return marks[highestIndex(marks, size)];
}

int highestMarkCopy(int marks[], int size)
{
    return marks[highestIndex(marks, size)];
}

int* highestPointer(int marks[], int size)
{
    return &marks[highestIndex(marks, size)];
}

void task2()
{
    cout << "\n========== TASK 2 ==========\n";

    int marks[5] = {75, 98, 87, 91, 85};

    cout << "Original Highest Mark: "
         << highestMark(marks, 5) << endl;

    highestMark(marks, 5) += 2;

    cout << "After Moderation: "
         << highestMark(marks, 5) << endl;

    cout << "Const Reference: "
         << highestMarkConst(marks, 5) << endl;

    cout << "Copy: "
         << highestMarkCopy(marks, 5) << endl;

    int index = highestIndex(marks, 5);
    cout << "Using Index: " << marks[index] << endl;

    int* ptr = highestPointer(marks, 5);
    cout << "Using Pointer: " << *ptr << endl;

    cout << "Dangling references are unsafe and avoided.\n";
}

// TASK 3 - DEFAULT ARGUMENTS AND OVERLOADING

struct Parcel
{
    double weight;
    bool express;
    bool insured;
};

double calculateCharge(double weight, bool express, bool insured)
{
    double amount = 40 + weight * 20;

    if (express)
        amount += 30;

    if (insured)
        amount += 15;

    return amount;
}

double charge(int grams, bool express = false, bool insured = false)
{
    return calculateCharge(grams / 1000.0, express, insured);
}

double charge(double kg, bool express = false, bool insured = false)
{
    return calculateCharge(kg, express, insured);
}

double charge(const Parcel& p)
{
    return calculateCharge(p.weight, p.express, p.insured);
}

