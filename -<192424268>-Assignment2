    cout << "2 grams: " << charge(2) << endl;
    cout << "2.0f kg: " << charge(2.0f) << endl;
    cout << "2.0 kg: " << charge(2.0) << endl;
    cout << "500 grams: " << charge(500) << endl;
    cout << "Express Delivery: " << charge(2, true) << endl;

    Parcel p = {2.5, false, true};

    cout << "Parcel Charge: " << charge(p) << endl;
}

// TASK 4 - CLASS WITH ARRAY

class SavingsAccount
{
private:
    int accountNumber;
    double balance;
    double transactions[10];
    int count;

    void addTransaction(double amount)
    {
        if (count < 10)
        {
            transactions[count] = amount;
            count++;
        }
        else
        {
            for (int i = 0; i < 9; i++)
                transactions[i] = transactions[i + 1];

            transactions[9] = amount;
        }
    }

public:
    SavingsAccount(int accNo, double initialBalance)
    {
        accountNumber = accNo;
        balance = initialBalance;
        count = 0;
    }

    void deposit(double amount);
    void withdraw(double amount);
    void miniStatement();
};

void SavingsAccount::deposit(double amount)
{
    if (amount > 0)
    {
        balance += amount;
        addTransaction(amount);
        cout << "Deposited: " << amount << endl;
    }
    else
    {
        cout << "Invalid deposit\n";
    }
}

void SavingsAccount::withdraw(double amount)
{
    if (amount > 0 && amount <= balance)
    {
        balance -= amount;
        addTransaction(-amount);
        cout << "Withdrawn: " << amount << endl;
    }
    else
    {
        cout << "Invalid withdrawal\n";
    }
}

void SavingsAccount::miniStatement()
{
    cout << "\nAccount Number: " << accountNumber << endl;
    cout << "Balance: " << balance << endl;
    cout << "Last Transactions:\n";

    for (int i = 0; i < count; i++)
    {
        if (transactions[i] >= 0)
            cout << "Deposit: " << transactions[i] << endl;
        else
            cout << "Withdrawal: " << -transactions[i] << endl;
    }
}

