// TASK 5 - STATIC MEMBERS AND OBJECT ARRAYS

class Token
{
private:
    static int next;
    int id;

public:
    Token()
    {
        id = ++next;
    }

    int get() const
    {
        return id;
    }

    static int issued()
    {
        return next - 100;
    }
};

int Token::next = 100;

class BusTicket
{
private:
    static int issued;
    static const int CAPACITY = 3;

    int seat;
    string name;

public:
    explicit BusTicket(const string& n)
    {
        name = n;
        seat = 0;

        if (issued < CAPACITY)
        {
            issued++;
            seat = issued;
        }
    }

    static int count()
    {
        return issued;
    }

    void print() const
    {
        cout << name << ": ";

        if (seat != 0)
            cout << "Seat " << seat;
        else
            cout << "Waiting";

        cout << endl;
    }
};

