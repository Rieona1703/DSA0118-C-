// Switch-based bill
struct SimpleBill {
    int type;

    double total() const {
        switch (type) {
            case 0: return 1700;
            case 1: return 47500;
            default: return 0;
        }
    }
};

// Validation methods
bool validateCode(int amount) {
    return amount >= 0;
}

void validateException(int amount) {
    if (amount < 0)
        throw invalid_argument("negative");
}

// B3 virtual vs switch benchmark
void benchmarkBills(size_t n) {
    vector<unique_ptr<Bill>> bills;
    vector<SimpleBill> simple;

    bills.reserve(n);
    simple.reserve(n);

    for (size_t i = 0; i < n; i++) {
        if (i % 2 == 0)
            bills.push_back(
                make_unique<OutPatient>("Test", 500, 1200));
        else
            bills.push_back(
                make_unique<InPatient>("Test", 3, 2500, 40000));

        simple.push_back({static_cast<int>(i % 2)});
    }

    double sum1 = 0, sum2 = 0;

    auto start = steady_clock::now();

    for (const auto& b : bills)
        sum1 += b->total();

    auto mid = steady_clock::now();

    for (const auto& b : simple)
        sum2 += b.total();

    auto end = steady_clock::now();

    cout << "\nBills: " << n << endl;
    cout << "Virtual Total: " << sum1 << endl;
    cout << "Switch Total: " << sum2 << endl;
    cout << "Results Match: "
         << (sum1 == sum2 ? "YES" : "NO") << endl;

    cout << "Virtual Time (ms): "
         << duration<double, milli>(mid - start).count()
         << endl;

    cout << "Switch Time (ms): "
         << duration<double, milli>(end - mid).count()
         << endl;
}

// Exception vs return code benchmark
void benchmarkErrors(int invalidPercent) {
    const int N = 1000000;
    int valid1 = 0, valid2 = 0;

    auto start = steady_clock::now();

    for (int i = 0; i < N; i++) {
        int amount = (i % 100 < invalidPercent) ? -1 : 100;

        if (validateCode(amount))
            valid1++;
    }

    auto mid = steady_clock::now();

    for (int i = 0; i < N; i++) {
        int amount = (i % 100 < invalidPercent) ? -1 : 100;

        try {
            validateException(amount);
            valid2++;
        }
        catch (const invalid_argument&) {
        }
    }

    auto end = steady_clock::now();

    cout << "\nInvalid Claims: " << invalidPercent << "%" << endl;

    cout << "Return Code Time (ms): "
         << duration<double, milli>(mid - start).count()
         << endl;

    cout << "Exception Time (ms): "
         << duration<double, milli>(end - mid).count()
         << endl;

    cout << "Valid Counts: " << valid1
         << ", " << valid2 << endl;
}

