// Exception classes
class BillingError : public runtime_error {
public:
    using runtime_error::runtime_error;
};

class ClaimError : public BillingError {
public:
    using BillingError::BillingError;
};

class PackageError : public BillingError {
public:
    using BillingError::BillingError;
};

// Abstract Bill class
class Bill {
protected:
    string patient;

    static void check(double amount) {
        if (amount < 0)
            throw BillingError("Negative charge");
    }

public:
    explicit Bill(string p) : patient(p) {
        if (p.empty())
            throw BillingError("Missing patient record");
    }

    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    void print() const {
        cout << type() << " " << patient
             << ": " << total() << endl;
    }
};

// Outpatient bill
class OutPatient : public Bill {
    double consultation, tests;

public:
    OutPatient(string p, double c, double t)
        : Bill(p), consultation(c), tests(t) {
        check(c);
        check(t);
    }

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

// Inpatient bill
class InPatient : public Bill {
    int days;
    double rate, surgery;

public:
    InPatient(string p, int d, double r, double s)
        : Bill(p), days(d), rate(r), surgery(s) {
        if (d < 0)
            throw BillingError("Negative days");
        check(r);
        check(s);
    }

    double total() const override {
        return days * rate + surgery;
    }

    string type() const override {
        return "IP";
    }
};

// Daycare bill
class DayCare : public Bill {
    double package;

public:
    DayCare(string p, double amount)
        : Bill(p), package(amount) {
        check(amount);
    }

    double total() const override {
        return package;
    }

    string type() const override {
        return "DayCare";
    }
};

// Emergency bill
class Emergency : public Bill {
    double base, hourlyRate;
    int hours;

public:
    Emergency(string p, double b, double r, int h)
        : Bill(p), base(b), hourlyRate(r), hours(h) {
        check(b);
        check(r);
        if (h < 0)
            throw BillingError("Negative hours");
    }

    double total() const override {
        return base + hourlyRate * hours;
    }

    string type() const override {
        return "Emergency";
    }
};

// New bill type - B4 extension
class DentalBill : public Bill {
    double treatment;

public:
    DentalBill(string p, double t)
        : Bill(p), treatment(t) {
        check(t);
    }

    double total() const override {
        return treatment;
    }

    string type() const override {
        return "Dental";
    }
};

// Abstract Payer class
class Payer {
public:
    virtual ~Payer() = default;
    virtual string name() const = 0;
    virtual double amountCovered(const Bill& b) const = 0;
};

class SelfPay : public Payer {
public:
    string name() const override {
        return "SelfPay";
    }

    double amountCovered(const Bill&) const override {
        return 0;
    }
};

class Insurance : public Payer {
    double limit, copay;

public:
    Insurance(double l, double c)
        : limit(l), copay(c) {
        if (l < 0 || c < 0 || c > 100)
            throw BillingError("Invalid insurance policy");
    }

    string name() const override {
        return "Insurance";
    }

    double amountCovered(const Bill& b) const override {
        return min(limit, b.total() * (1 - copay / 100));
    }
};

class GovernmentScheme : public Payer {
public:
    string name() const override {
        return "Government";
    }

    double amountCovered(const Bill& b) const override {
        if (b.type() == "DayCare")
            return min(12000.0, b.total());

        if (b.type() == "IP")
            return min(20000.0, b.total());

        throw PackageError("Unknown government package");
    }
};

// New payer - B4 extension
class CorporatePayer : public Payer {
public:
    string name() const override {
        return "Corporate";
    }

    double amountCovered(const Bill& b) const override {
        return b.total() * 0.75;
    }
};

// Claim approval and rethrowing
double approve(double billed, double cover) {
    if (billed < 0 || cover < 0)
        throw invalid_argument("negative amount");

    if (billed > cover)
        throw ClaimError("exceeds cover");

    return billed;
}

double settle(double billed, double cover) {
    try {
        return approve(billed, cover);
    }
    catch (const ClaimError& e) {
        cout << "audit: " << e.what() << endl;
        throw;
    }
}

