// ======================= TASK 4: pointers to derived classes =======================
namespace t4 {
struct A1 { double rate() const { return 3.5; } virtual double vrate() const { return 3.5; } virtual ~A1() = default; };
struct S1 : A1 { double rate() const { return 4.0; } double vrate() const override { return 4.0; } };
class Account {                                                  // repaired
public:
    Account() = default;
    Account(const Account&) = delete;                            // forbid slicing copies
    virtual double rate() const { return 3.5; }
    virtual ~Account() { cout << "~Account\n"; }
};
class SeniorAccount : public Account {
    double* history = new double[100];
public:
    double rate() const override { return 4.0; }
    ~SeniorAccount() override { cout << "~SeniorAccount\n"; delete[] history; }
};
void run() {
    sec("Predict: static vs dynamic binding, slicing");
    S1 s; A1* p = &s; A1 copy = s;
    cout << p->rate() << ' ' << p->vrate() << ' ' << copy.vrate() << '\n';
    sec("Repaired: virtual rate() and virtual destructor");
    Account* accounts[2] = { new Account, new SeniorAccount };
    for (Account* a : accounts) cout << a->rate() << "\n";
    for (Account* a : accounts) delete a;                        // runs ~SeniorAccount first
    SeniorAccount sa; Account& ref = sa; cout << ref.rate() << "\n";   // reference: no slicing
    sec("Alternative: unique_ptr in a vector");
    vector<unique_ptr<Account>> v;
    v.push_back(make_unique<Account>()); v.push_back(make_unique<SeniorAccount>());
    for (auto& a : v) cout << a->rate() << "\n";
}                                                                // vector then sa destroyed here
}

// ======================= TASK 5: pointers to objects and this =======================
namespace t5 {
class Cart {
    string items[10]; double prices[10]; int n = 0; double discount = 0;
public:
    Cart& add(const string& item, double price) { if (n < 10) { items[n] = item; prices[n] = price; ++n; } return *this; }
    Cart& setDiscount(double discount) { this->discount = discount; return *this; }
    double total() const { double t = 0; for (int i = 0; i < n; ++i) t += prices[i]; return t * (100 - discount) / 100; }
};
struct ByVal { int n = 0; ByVal add() { ++n; return *this; } };  // returns a COPY
void run() {
    cout << fixed << setprecision(2);
    Cart a; a.add("Rice", 60).add("Dal", 120).setDiscount(10);   // (a) direct + chaining
    Cart* p = &a; p->add("Oil", 180);                            // (b) pointer
    cout << "a: " << a.total() << "  via p: " << p->total() << "\n";
    Cart& r = a; r.add("Salt", 20); cout << "after ref: " << r.total() << "\n";   // (c) reference
    Cart* h = new Cart; h->add("Tea", 100).setDiscount(5);       // (d) new / delete
    cout << "heap: " << h->total() << "\n"; delete h;
    Cart* carts[3] = { new Cart, new Cart, new Cart };           // array of pointers
    carts[0]->add("A", 100); carts[1]->add("B", 300).add("C", 50); carts[2]->add("D", 200);
    Cart** best = carts;
    for (Cart** q = carts + 1; q < carts + 3; ++q) if ((*q)->total() > (*best)->total()) best = q;
    cout << "highest cart index " << (best - carts) << " total " << (*best)->total() << "\n";
    for (Cart* c : carts) delete c;
    sec("Returning by value breaks chaining");
    ByVal bv; bv.add().add().add(); cout << bv.n << " (expected 3 with a reference return)\n";
    sec("Alternative: vector<Cart> invalidates pointers");
    vector<Cart> v(1); Cart* first = &v[0];
    for (int i = 0; i < 100; ++i) v.emplace_back();
    cout << "pointer still valid? " << (first == &v[0] ? "yes" : "NO (dangling)") << "  capacity=" << v.capacity() << "\n";
}
}

// ======================= TASK 6: vehicle rental fleet =======================
namespace t6 {
struct Date { int d = 1, m = 1, y = 2026; string str() const { return to_string(d) + "/" + to_string(m) + "/" + to_string(y); } };
class Vehicle {                                                  // abstract base
protected: string reg; double rate; bool rented = false;
public:
    Vehicle(string r, double d) : reg(move(r)), rate(d) {}
    virtual ~Vehicle() = default;
    virtual double charge(int days, int late) const = 0;         // pure virtual
    virtual string type() const = 0;
    virtual void show() const { cout << type() << " " << reg << " Rs." << rate << "/day " << (rented ? "[RENTED]" : "[AVAILABLE]"); }
    const string& regNo() const { return reg; }
    bool isRented() const { return rented; }
    void setRented(bool b) { rented = b; }
};
struct Bicycle : Vehicle {
    using Vehicle::Vehicle;
    double charge(int d, int late) const override { return rate * d + late * rate; }
    string type() const override { return "Bicycle"; }
};
class MotorVehicle : public Vehicle {                            // abstract: fuel + service date (member class)
protected: double fuel; Date service;
public:
    MotorVehicle(string r, double d, double f, Date s) : Vehicle(move(r), d), fuel(f), service(s) {}
    void show() const override { Vehicle::show(); cout << " fuel/charge=" << fuel << "% service=" << service.str(); }
};
struct TwoWheeler : MotorVehicle {
    using MotorVehicle::MotorVehicle;
    double charge(int d, int late) const override { return rate * d + late * rate * 1.5 + 6.0 * (100 - fuel) * 0.05; }
    string type() const override { return "TwoWheeler"; }
};
class Car : public MotorVehicle {
protected: int seats;
public:
    Car(string r, double d, double f, Date s, int st) : MotorVehicle(move(r), d, f, s), seats(st) {}
    double charge(int d, int late) const override { return rate * d + late * rate * 1.5 + 6.0 * (100 - fuel) * 0.4; }
    string type() const override { return "Car"; }
};
class ElectricCar : public Car {
    double kwh;
public:
    ElectricCar(string r, double d, double f, Date s, int st, double k) : Car(move(r), d, f, s, st), kwh(k) {}
    double charge(int d, int late) const override { return rate * d + late * rate * 1.5 + 9.0 * kwh * (100 - fuel) / 100; }
    string type() const override { return "ElectricCar"; }
};
class ElectricBus : public MotorVehicle {                        // NEW type: no existing class is edited
    double kwh;
public:
    ElectricBus(string r, double d, double f, Date s, double k) : MotorVehicle(move(r), d, f, s), kwh(k) {}
    double charge(int d, int late) const override { return rate * d + late * rate * 2.0 + 7.5 * kwh * (100 - fuel) / 100; }
    string type() const override { return "ElectricBus"; }
};
class Fleet {
    vector<unique_ptr<Vehicle>> v;                               // base-class pointers
    Vehicle* find(const string& r) { for (auto& p : v) if (p->regNo() == r) return p.get(); return nullptr; }
public:
    void add(unique_ptr<Vehicle> p) { v.push_back(move(p)); }
    bool rent(const string& r) { Vehicle* p = find(r); if (!p || p->isRented()) return false; p->setRented(true); return true; }
    double giveBack(const string& r, int days, int late) {
        Vehicle* p = find(r); if (!p || !p->isRented()) return -1;
        p->setRented(false); return p->charge(days, late);       // virtual call
    }
    void list() const { for (auto& p : v) { p->show(); cout << "\n"; } }
};
enum VType { BICYCLE, TWO, CAR, ECAR };                          // alternative: one class + switch
struct OneVehicle {
    VType type; string reg; double rate, fuel = 0, kwh = 0; int seats = 0, sd = 0, sm = 0, sy = 0;
    double charge(int d, int late) const { switch (type) {
        case BICYCLE: return rate * d + late * rate;
        case TWO: return rate * d + late * rate * 1.5 + 6.0 * (100 - fuel) * 0.05;
        case CAR: return rate * d + late * rate * 1.5 + 6.0 * (100 - fuel) * 0.4;
        default: return rate * d + late * rate * 1.5 + 9.0 * kwh * (100 - fuel) / 100; } }
};
struct V { virtual double charge(int d) const = 0; virtual ~V() = default; };       // benchmark
template <int K> struct Impl : V { double charge(int d) const override { return d * (K == 0 ? 100.0 : K == 1 ? 300.0 : K == 2 ? 1500.0 : 2000.0) + K; } };
inline double sw(int t, int d) { switch (t) { case 0: return d * 100.0; case 1: return d * 300.0 + 1; case 2: return d * 1500.0 + 2; default: return d * 2000.0 + 3; } }
void run() {
    Fleet f;
    f.add(make_unique<Bicycle>("BC-01", 100));
    f.add(make_unique<TwoWheeler>("TW-01", 300, 40, Date{1, 12, 2026}));
    f.add(make_unique<Car>("CR-01", 1500, 50, Date{15, 12, 2026}, 5));
    f.add(make_unique<ElectricCar>("EC-01", 2000, 30, Date{10, 1, 2027}, 5, 40));
    sec("Initial fleet"); f.list();
    sec("Rent");
    for (string r : {"BC-01", "TW-01", "CR-01", "EC-01"}) cout << "Rent " << r << ": " << (f.rent(r) ? "ok" : "fail") << "\n";
    cout << "Rent BC-01 again: " << (f.rent("BC-01") ? "ok" : "fail (already rented)") << "\n";
    sec("Return with late charge");
    cout << "BC-01 (2 days, 0 late): Rs." << f.giveBack("BC-01", 2, 0) << "\n";
    cout << "TW-01 (3 days, 1 late): Rs." << f.giveBack("TW-01", 3, 1) << "\n";
    cout << "CR-01 (2 days, 2 late): Rs." << f.giveBack("CR-01", 2, 2) << "\n";
    cout << "EC-01 (1 day, 1 late):  Rs." << f.giveBack("EC-01", 1, 1) << "\n";
    sec("Add ElectricBus without changing existing classes");
    f.add(make_unique<ElectricBus>("EB-01", 5000, 60, Date{20, 2, 2027}, 200)); f.rent("EB-01");
    cout << "EB-01 (1 day, 1 late): Rs." << f.giveBack("EB-01", 1, 1) << "\n"; f.list();
    sec("Alternative: type code + switch");
    cout << OneVehicle{CAR, "CR-01", 1500, 50}.charge(2, 2) << "  sizeof(OneVehicle)=" << sizeof(OneVehicle) << "\n";
    sec("Benchmark: virtual vs switch");
    const int N = 4000000; vector<unique_ptr<V>> vs; vector<int> ts;
    for (int i = 0; i < N; ++i) { int t = (i * 7 + i / 3) % 4; ts.push_back(t);
        if (t == 0) vs.push_back(make_unique<Impl<0>>()); else if (t == 1) vs.push_back(make_unique<Impl<1>>());
        else if (t == 2) vs.push_back(make_unique<Impl<2>>()); else vs.push_back(make_unique<Impl<3>>()); }
    auto t0 = chrono::steady_clock::now(); double s1 = 0, s2 = 0;
    for (int k = 1; k <= 10; ++k) for (auto& p : vs) s1 += p->charge(k);
    auto t1 = chrono::steady_clock::now();
    for (int k = 1; k <= 10; ++k) for (int t : ts) s2 += sw(t, k);
    auto t2 = chrono::steady_clock::now();
    cout << "virtual: " << chrono::duration<double, milli>(t1 - t0).count() << " ms   switch: "
         << chrono::duration<double, milli>(t2 - t1).count() << " ms  (" << N * 10 << " calls)\n";
    if (s1 < 0 || s2 < 0) cout << "never\n";
}
}

