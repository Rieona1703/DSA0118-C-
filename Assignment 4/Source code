// ======================= TASK 1: payroll hierarchy =======================
namespace t1 {
class Staff {                                        // abstract base
protected: string name; int id;
public:
    Staff(string n, int i) : name(move(n)), id(i) {}
    virtual ~Staff() = default;
    virtual double pay() const = 0;
    virtual string role() const = 0;
    void print() const { cout << role() << " " << id << " " << name << " Rs." << pay() << "\n"; }
};
class SalariedStaff : public Staff {                 // DA rule written once
protected:
    double basic; static constexpr double DA = 0.42;
    double withDA() const { return basic * (1 + DA); }
public: SalariedStaff(string n, int i, double b) : Staff(move(n), i), basic(b) {}
};
class Professor : public SalariedStaff {
    double research;
public:
    Professor(string n, int i, double b, double r) : SalariedStaff(move(n), i, b), research(r) {}
    double pay() const override { return withDA() + research; }
    string role() const override { return "Professor"; }
};
struct LabAssistant : SalariedStaff {
    using SalariedStaff::SalariedStaff;
    double pay() const override { return withDA(); }
    string role() const override { return "LabAssistant"; }
};
class GuestFaculty : public Staff {
    double hours, rate;
public:
    GuestFaculty(string n, int i, double h, double r) : Staff(move(n), i), hours(h), rate(r) {}
    double pay() const override { return hours * rate; }
    string role() const override { return "GuestFaculty"; }
};
enum Type { PROF, LAB, GUEST };                      // alternative: one class + switch
struct OneStaff {
    Type type; string name; int id; double basic = 0, research = 0, hours = 0, rate = 0;
    double pay() const { switch (type) { case PROF: return basic * 1.42 + research;
        case LAB: return basic * 1.42; default: return hours * rate; } }
};
void run() {
    vector<unique_ptr<Staff>> all; double total = 0;
    all.push_back(make_unique<Professor>("Meena", 101, 50000, 8000));
    all.push_back(make_unique<LabAssistant>("Ravi", 102, 20000));
    all.push_back(make_unique<GuestFaculty>("Anita", 103, 40, 1500));
    for (auto& s : all) { s->print(); total += s->pay(); }      // one loop for all staff
    cout << "Total payroll: Rs." << total << "\n";
    sec("Alternative: one class + switch");
    cout << OneStaff{PROF, "Meena", 101, 50000, 8000}.pay() << " sizeof(OneStaff)=" << sizeof(OneStaff)
         << " Professor=" << sizeof(Professor) << " Lab=" << sizeof(LabAssistant) << " Guest=" << sizeof(GuestFaculty) << "\n";
}
}

